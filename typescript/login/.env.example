# 複製成 .env 後即可使用：cp .env.example .env
#
# 這份是「根目錄」的 .env，給 docker compose 與 apps/server 用。
# apps/web 與 apps/mobile 有各自的 .env（Vite / Expo 只讀 app 目錄下的），見它們的 .env.example。

# ── Postgres ────────────────────────────────────────────────
# docker-compose.yml 用這三個變數建立資料庫。
# 這是本機開發用的憑證，刻意簡單；生產環境絕不能沿用。
DB_NAME="ims"
DB_USER="root"
DB_PASSWORD="password123"

# 本機已經裝了 Postgres 的話，改這個避免撞port（容器內固定是 5432）
DB_PORT="5432"

# Drizzle 與 Better Auth 讀這一條。
# 內容必須與上面四個變數一致——compose 沒辦法幫你組出這個字串，所以是手動同步的。
DATABASE_URL="postgres://root:password123@localhost:5432/ims"

# ── Mailpit ─────────────────────────────────────────────────
# SMTP 收信端口，Stage 2 的 MailPort adapter 會寄到這裡
MAILPIT_SMTP_PORT="1025"
# Web UI：開 http://localhost:8025 看收到的信
MAILPIT_UI_PORT="8025"

# ── Server ──────────────────────────────────────────────────
PORT="3000"

# ── Better Auth ─────────────────────────────────────────────
# 簽 session cookie 與 token 的金鑰。自己產一組：openssl rand -base64 32
# 不設的話 Better Auth 會自己生一組隨機值，結果是每次重啟 server 所有 session 都失效——
# 所以 apps/server/src/auth.ts 選擇缺了就直接擋下來。
BETTER_AUTH_SECRET="請自己產一組：openssl rand -base64 32"

# server 對外的位址，Better Auth 用它組驗證信連結與 OIDC 的 issuer。
# 要與 PORT 一致；之後 Stage 1 的 OIDC discovery document 也以此為根。
BETTER_AUTH_URL="http://localhost:3000"

# 實體手機要連進來時填開發機的區網 IP（例如 http://192.168.1.23:3000）
# 查法：macOS `ipconfig getifaddr en0`。沒填的話 Swagger 只會列 localhost。
# LAN_URL=""
