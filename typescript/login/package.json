{
  "name": "ims",
  "private": true,
  "scripts": {
    "mobile": "pnpm --filter @ims/mobile start",
    "web": "pnpm --filter @ims/web dev",
    "server": "pnpm --filter @ims/server dev",
    "test": "pnpm -r test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:types": "oxlint --type-aware",
