    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@usebruno/cli": "^4.0.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.34.5"
}
