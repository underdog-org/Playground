  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@ims/contract": "workspace:*",
    "@ims/db": "workspace:*",
    "@scalar/fastify-api-reference": "^1.63.0",
    "better-auth": "catalog:",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "auth": "catalog:",
    "tsx": "^4.23.1",
    "typescript": "catalog:"
  }
}
